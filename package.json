{
  "name": "pw-testing",
  "version": "0.1.0",
  "private": true,
  "description": "Automation E2E untuk VocaGame dengan TypeScript + Playwright (port dari suite Python/Selenium).",
  "type": "module",
  "scripts": {
    "test": "playwright test -c vocagame/playwright.config.ts",
    "test:headed": "playwright test -c vocagame/playwright.config.ts --headed",
    "test:ui": "playwright test -c vocagame/playwright.config.ts --ui",
    "test:report": "playwright show-report",
    "typecheck": "tsc -p vocagame/tsconfig.json",
    "browsers:install": "playwright install chromium"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "e2e",
    "qa",
    "selenium-migration",
    "vocagame"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
