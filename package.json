{
  "name": "pw-testing",
  "version": "0.1.0",
  "private": true,
  "description": "Generate Playwright test specs from QA test-case CSV files (UI & API).",
  "type": "module",
  "bin": {
    "tcgen": "./dist/cli.js"
  },
  "scripts": {
    "gen": "tsx src/cli.ts",
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "typecheck:vocagame": "tsc -p vocagame/tsconfig.json",
    "test:e2e": "playwright test",
    "demo": "tsx src/cli.ts examples/ui-testcases.sample.csv -o tests/generated"
  },
  "keywords": [
    "playwright",
    "qa",
    "test-generation",
    "test-case",
    "automation"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
